generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum FieldType {
  SAN_5
  SAN_7
}

enum FieldStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DayType {
  WEEKDAY
  WEEKEND
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           Int        @id @default(autoincrement())
  fullName     String     @map("full_name")
  phone        String     @unique
  email        String?    @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(CUSTOMER)
  createdAt    DateTime   @default(now()) @map("created_at")
  bookings     Booking[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Field {
  id          Int         @id @default(autoincrement())
  name        String
  fieldType   FieldType   @default(SAN_5) @map("field_type")
  status      FieldStatus @default(ACTIVE)
  description String?
  imageUrl    String?     @map("image_url")
  ward        String?     // Phường / Xã tại Buôn Ma Thuột
  address     String?     // Địa chỉ chính
  phone       String?     // Liên hệ sân
  createdAt   DateTime    @default(now()) @map("created_at")
  priceRules  PriceRule[]
  bookings    Booking[]

  @@map("fields")
}

model TimeSlot {
  id         Int         @id @default(autoincrement())
  label      String
  startTime  String      @map("start_time")
  endTime    String      @map("end_time")
  isPeakHour Boolean     @default(false) @map("is_peak_hour")
  priceRules PriceRule[]
  bookings   Booking[]

  @@map("time_slots")
}

model PriceRule {
  id         Int      @id @default(autoincrement())
  fieldId    Int      @map("field_id")
  timeSlotId Int      @map("time_slot_id")
  dayType    DayType  @default(WEEKDAY) @map("day_type")
  price      Decimal  @db.Decimal(12, 2)
  field      Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@unique([fieldId, timeSlotId, dayType])
  @@map("price_rules")
}

model Booking {
  id            Int           @id @default(autoincrement())
  bookingCode   String        @unique @map("booking_code")
  customerId    Int?          @map("customer_id")
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  fieldId       Int           @map("field_id")
  timeSlotId    Int?          @map("time_slot_id")
  startAt       DateTime      @map("start_at")
  endAt         DateTime      @map("end_at")
  unitPrice     Decimal       @map("unit_price") @db.Decimal(12, 2)
  totalPrice    Decimal       @map("total_price") @db.Decimal(12, 2)
  status        BookingStatus @default(PENDING)
  cancelReason  String?       @map("cancel_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  customer      User?         @relation(fields: [customerId], references: [id])
  field         Field         @relation(fields: [fieldId], references: [id])
  timeSlot      TimeSlot?     @relation(fields: [timeSlotId], references: [id])
  invoice       Invoice?

  @@index([fieldId, startAt, endAt])
  @@index([status])
  @@map("bookings")
}

model Invoice {
  id          Int           @id @default(autoincrement())
  invoiceCode String        @unique @map("invoice_code")
  bookingId   Int           @unique @map("booking_id")
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  status      InvoiceStatus @default(UNPAID)
  createdAt   DateTime      @default(now()) @map("created_at")
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@map("invoices")
}

model Payment {
  id            Int           @id @default(autoincrement())
  invoiceId     Int           @map("invoice_id")
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?     @map("paid_at")
  referenceCode String?       @map("reference_code")
  createdAt     DateTime      @default(now()) @map("created_at")
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paidAt, status])
  @@map("payments")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    String?  @db.Text
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("audit_logs")
}
